{
  "name": "expense-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cd frontend && pnpm dev",
    "dev:backend": "cd backend && pnpm dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:backend\"",
    "build": "cd frontend && pnpm build",
    "build:backend": "cd backend && pnpm build",
    "start": "cd frontend && pnpm start",
    "start:backend": "cd backend && pnpm start",
    "install:all": "pnpm install && cd frontend && pnpm install && cd ../backend && pnpm install",
    "db:generate": "cd backend && pnpm db:generate",
    "db:push": "cd backend && pnpm db:push",
    "db:migrate": "cd backend && pnpm db:migrate"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  }
}
